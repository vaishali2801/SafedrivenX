# SAFEdriveX Server Environment Variables

PORT=5001

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/safedrivex

JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Frontend origin (Vite dev server)
CLIENT_URL=http://localhost:5173

NODE_ENV=development

# Optional: Cloudinary for image uploads (user/vehicle images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Default emergency contact used when a user has none configured
DEFAULT_EMERGENCY_CONTACT=+91-9876543210
